{
  "name": "leads-cm-cli",
  "version": "0.1.0",
  "description": "Command-line access to authorized leads.cm LinkedIn data",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "leads-cm": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx scripts/live-contract.ts",
    "test:large": "pnpm build && tsx scripts/large-stream.ts",
    "test:package": "pnpm build && tsx scripts/package-smoke.ts",
    "test:skill-install": "tsx scripts/skill-install-smoke.ts",
    "package:macos": "tsx scripts/build-macos-package.ts",
    "test:package:macos": "node --import tsx scripts/macos-package-smoke.ts"
  },
  "dependencies": {
    "@streamparser/json": "^0.0.22",
    "string-dedent": "^3.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
